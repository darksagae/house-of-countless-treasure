# Server only. Never put these values in public/.
YOUCAM_API_KEY=
STUDIO_ACCESS_CODE=
# Neon integration injects DATABASE_URL / POSTGRES_URL and NEON_AUTH_BASE_URL.
DATABASE_URL=
NEON_AUTH_BASE_URL=
# Optional; otherwise derived from NEON_AUTH_BASE_URL. Public verification endpoint.
NEON_AUTH_JWKS_URL=
# Set only for a local HTTP preview.
LOCAL_PREVIEW=1
